class TripsApi : ServerApi {

    constructor(string baseUrl, IUserTokenProvider tokenProvider): base(baseUrl, tokenProvider) {
           // Initialize the HttpClient with any necessary configuration
       }

    fun getTrips(): List<Trip> {
        val response = get("/trips")
        return parseTrips(response)
    }

    fun createTrip(trip: Trip): Trip {
        val response = post("/trips", trip)
        return parseTrip(response)
    }

    fun updateTrip(trip: Trip): Trip {
        val response = put("/trips/${trip.id}", trip)
        return parseTrip(response)
    }
}

