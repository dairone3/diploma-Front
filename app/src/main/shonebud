class ApiFactory {
 private ApiFactory() {)

 public static getInstance();

 public func createTripsApi(baseUrl: String, tokenProvider: IUserTokenProvider, appToken: String): TripsApi {
     if (isAndroid) {
         return new TripsApi(new AndroidHttpClient(baseUrl, tokenProvider))
     } else {
         return new TripsApi(new iOsHttpClient(baseUrl, tokenProvider))
     }
 }
}


