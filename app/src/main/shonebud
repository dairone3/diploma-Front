interface IHttpClient {
    fun get(url: String): HttpResponse
    fun post(url: String, body: Any): HttpResponse
    fun put(url: String, body: Any): HttpResponse
}

class UserTokenHttpClient : IHttpClient {
    HttpClient client = new HttpClient();

    constructor(string baseUrl, IUserTokenProvider tokenProvider) {
        // Initialize the HttpClient with any necessary configuration
    }

    override fun get(url: String): HttpResponse {
        client.setToken(getToken())
        return client.get(url)
    }

    override fun post(url: String, body: Any): HttpResponse {
        client.setToken(getToken())
        return client.post(url, body)
    }

    override fun put(url: String, body: Any): HttpResponse {
        client.setToken(getToken())
        return client.put(url, body)
    }
}

class PublicHttpClient : IHttpClient {
    HttpClient client = new HttpClient();

   constructor(string baseUrl) {
       // Initialize the HttpClient with any necessary configuration
   }

    override fun get(url: String): HttpResponse {
        return client.get(url)
    }

    override fun post(url: String, body: Any): HttpResponse {
        return client.post(url, body)
    }

    override fun put(url: String, body: Any): HttpResponse {
        return client.put(url, body)
    }
}

class AppTokenHttpClient : IHttpClient {
    HttpClient client = new HttpClient();
    string appToken = "your_app_token_here"; // Replace with your actual

   constructor(string baseUrl, string appToken, params.... objects) {
       // Initialize the HttpClient with any necessary configuration
   }

    override fun get(url: String): HttpResponse {
        client.setToken(appToken)
        return client.get(url)
    }

    override fun post(url: String, body: Any): HttpResponse {
        client.setToken(appToken)
        return client.post(url, body)
    }

    override fun put(url: String, body: Any): HttpResponse {
        client.setToken(appToken)
        return client.put(url, body)
    }
}


